# Backend Environment Variables
# Copy this file to .env and fill in your values

# ============ DATABASE ============
# PostgreSQL connection string
# Local: postgresql://postgres:postgres123@localhost:5432/portfolio_db
# Production (Neon): postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/portfolio_db?sslmode=require
# Production (Supabase): postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/portfolio_db

# ============ SECURITY ============
# Generate with: openssl rand -hex 32
# MUST be changed in production!
SECRET_KEY=your-super-secret-key-change-in-production-123456789

# JWT Algorithm (HS256 or RS256)
ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment: development, staging, production
ENVIRONMENT=development

# Login rate limiting (max attempts per 15 min window)
LOGIN_MAX_ATTEMPTS=5

# ============ ADMIN CREDENTIALS ============
# Admin username
ADMIN_USERNAME=admin

# DEPRECATED: Plaintext password (used only if ADMIN_PASSWORD_HASH is not set)
# ADMIN_PASSWORD=admin123

# PREFERRED: Bcrypt hash of admin password
# Generate with: python -m app.core.security_hash "your-password"
# ADMIN_PASSWORD_HASH=$2b$12$...

# Name used in email signatures
ADMIN_NAME=Rishikesh Saroj

# ============ CORS ============
# Comma-separated list of allowed frontend origins
# Production example: https://your-frontend.vercel.app,https://your-frontend.netlify.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ============ EMAIL SETTINGS ============
# SMTP server for sending reply emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmail: use an App Password (not your login password)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ============ CLOUDINARY ============
# Cloudinary credentials for image uploads
# Get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret